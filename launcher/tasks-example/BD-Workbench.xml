<?xml version="1.0" encoding="UTF-16"?>
<!--
  Example scheduled task for the workbench itself.

  Replace __PROJECT_ROOT__ with the checkout path and __NODE_DIR__ with your
  Node.js directory (usually C:\Program Files\nodejs). Console output is
  redirected into data\logs\ so the services page can display it.

  Register with:
    schtasks /create /tn BD-Workbench /xml launcher\tasks-example\BD-Workbench.xml /f
    schtasks /run    /tn BD-Workbench

  Build first: this runs the production server at .output\server\index.mjs.
-->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\BD-Workbench</URI>
    <Description>漫客工作台 local server (127.0.0.1:3020).</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers />
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c set "PATH=__NODE_DIR__;%PATH%" &amp;&amp; set PORT=3020 &amp;&amp; set BEATDESIGN_GENERATION_PROVIDER=comfyui &amp;&amp; cd /d "__PROJECT_ROOT__" &amp;&amp; node .output\server\index.mjs &gt; "__PROJECT_ROOT__\data\logs\workbench.log" 2&gt; "__PROJECT_ROOT__\data\logs\workbench.err.log"</Arguments>
      <WorkingDirectory>__PROJECT_ROOT__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>

<?xml version="1.0" encoding="UTF-16"?>
<!--
  Example scheduled task for ComfyUI.

  Replace __COMFY_ROOT__ with your ComfyUI install path (e.g. E:\ComfyUI) before
  importing. Logs are redirected into the workbench's data\logs\ directory so the
  services page can show them.

  Register with:
    schtasks /create /tn BD-ComfyUI /xml launcher\tasks-example\BD-ComfyUI.xml /f
    schtasks /run    /tn BD-ComfyUI
-->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\BD-ComfyUI</URI>
    <Description>ComfyUI local inference backend. Runs as SYSTEM so it survives logoff.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <!-- No triggers: start this manually or from the service console. Add a
       BootTrigger here if you want it to come up with the machine. -->
  <Triggers />
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c set "HF_ENDPOINT=https://hf-mirror.com" &amp;&amp; set "HF_HUB_DISABLE_TELEMETRY=1" &amp;&amp; "__COMFY_ROOT__\python_embeded\python.exe" -s ComfyUI\main.py --windows-standalone-build --use-sage-attention --disable-pinned-memory</Arguments>
      <WorkingDirectory>__COMFY_ROOT__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>

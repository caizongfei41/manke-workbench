# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# tanstack start / vite / nitro
/.output/
/.nitro/
/.tanstack/
/dist/
src/routeTree.gen.ts
src/paraglide/

# local agent state
/.claude/
/.agents/
/.codex/
/.cursor/
/.zcode/

# production
/build

# editors
.idea
.vscode
.playwright-mcp/
/test-results/
/playwright-report/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local secret files
.env
.env.*

# typescript
*.tsbuildinfo

# ---- local data: never commit user content ----
# data/ holds the project database, generated media, logs and the local ComfyUI
# config. The only thing worth tracking is the shipped workflow templates, so the
# exceptions below re-include exactly that one directory and nothing else.
/data/*
!/data/comfyui/
/data/comfyui/*
!/data/comfyui/workflows/

*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
src/config/db/schema.ts

# Model weights. The workflows need ~230 GB of them and GitHub caps a single
# file at 100 MB, so they are never committed. scripts/fetch-models.mjs checks
# which ones are installed; docs/DEPENDENCIES.md lists where each belongs.
*.safetensors
*.ckpt
*.gguf
*.onnx
*.pth
*.pt
# ...unless it is a tiny fixture a test actually needs
!tests/**/fixtures/*.pt

# Rendered output: films, per-shot clips, TTS tracks, generated stills
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.flac

# Junk the render scripts drop next to their output
**/run.log

# npm (project uses pnpm)
package-lock.json

# Runtime uploads and local QA artifacts
/public/uploads/
/public/demo-assets/
/promotion-kit/
/*-before.png
/design-qa-*.png
/design-qa.md
/canvas-rollback-empty.png
/.gstack/
.gstack/

# ---- fork-specific ----
# Local operator scripts and machine backups live outside this repo.
# (kept in a sibling directory so they cannot be committed by accident)
launcher/tasks-backup/

# Generated by scripts/make-app-icons.py from a supplied source image
public/*.bak

# UI 套件产物（截图、临时文件）
.verify/

# scratch scripts created while driving the browser
/_*.mjs
/_*.cjs
